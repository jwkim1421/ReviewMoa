{
  "manifest_version": 3,
  "name": "리뷰모아 수집 도우미",
  "version": "0.1.25",
  "description": "사용자가 연 상품 페이지에서 공개된 최신 리뷰를 별점별로 확인합니다.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://*.naver.com/*",
    "https://*.coupang.com/*",
    "https://*.kurly.com/*",
    "https://*.ohou.se/*",
    "https://*.11st.co.kr/*",
    "https://*.ssg.com/*",
    "https://*.gmarket.co.kr/*",
    "https://reviewmoa-api.reviewmoa.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "리뷰모아",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://reviewmoa.kro.kr/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.naver.com/*",
        "https://*.coupang.com/*",
        "https://*.kurly.com/*",
        "https://*.ohou.se/*",
        "https://*.11st.co.kr/*",
        "https://*.ssg.com/*",
        "https://*.gmarket.co.kr/*"
      ],
      "js": ["site-configs.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
